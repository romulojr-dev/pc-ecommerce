generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  // Partial unique index on CartItem (docs/specs/025-cart-single-items, D1)
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  sku             String                   @unique
  description     String?
  price           Int // in centavos: ₱12,999.00 = 1299900
  salePrice       Int? // in centavos
  // What the shopper pays: COALESCE(salePrice, price). Set by a database
  // trigger on every insert and update (docs/specs/012-common-filters), so
  // the app never writes it and the default is only a placeholder. Filters
  // and price sorts use it.
  effectivePrice  Int                      @default(0)
  // The migration also adds CHECK (stock >= 0), which Prisma can't express: a
  // backstop behind the conditional update that places an order
  // (docs/specs/030-place-an-order)
  stock           Int                      @default(0)
  lowStockAt      Int                      @default(5)
  specs           Json // shape defined and validated by lib/specs (docs/adr/0002)
  weightGrams     Int
  warrantyMonths  Int                      @default(12)
  // What ships in the retail box, one line per item, in display order
  boxContents     String[]                 @default([])
  // Expected ship date while on pre-order; null when not a pre-order. A
  // passed date ends the pre-order (lib/stock.ts, docs/specs/010-product-page).
  preorderShipsOn DateTime?                @db.Date
  status          ProductStatus            @default(DRAFT)
  // Shown in the home page's "Featured products" (docs/specs/016-home-page),
  // in place of best sellers until there is order data
  isFeatured      Boolean                  @default(false)
  categoryId      String
  category        Category                 @relation(fields: [categoryId], references: [id])
  brandId         String
  brand           Brand                    @relation(fields: [brandId], references: [id])
  images          ProductImage[]
  // Keyword search: name, brand, SKU, string spec values and category name,
  // weighted. Set by database triggers (docs/specs/014-search, ADR 0005), so
  // the app never writes it. Optional only because a required Unsupported
  // field would remove create() from Prisma Client; it is never null.
  searchVector    Unsupported("tsvector")?
  buildItems      BuildItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([searchVector], type: Gin)
  // jsonb_path_ops: spec filters are equality/containment (@>); smaller and faster than jsonb_ops for that
  @@index([specs(ops: JsonbPathOps)], type: Gin)
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// A shared build: an immutable snapshot of a build's items, found by its
// content hash so the same contents always give the same row and link
// (docs/specs/022-share-build, ADR 0007). The app never updates or deletes
// one. Saved builds and cart snapshots will point at these rows.
model Build {
  id          String      @id @default(cuid())
  // The link: 10 random characters of a-z and 0-9, never derived from the
  // contents
  shareSlug   String      @unique
  // SHA-256 hex of the canonical items; only the server makes it
  contentHash String      @unique
  items       BuildItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model BuildItem {
  id        String  @id @default(cuid())
  buildId   String
  build     Build   @relation(fields: [buildId], references: [id], onDelete: Cascade)
  // A builder slot (the category slug), checked in code, not a database enum
  // (ADR 0002)
  slot      String
  // Restrict: products are retired through status, never deleted, so a
  // snapshot's parts always exist (docs/specs/022-share-build, "The data").
  // The migration also adds CHECK (quantity >= 1), which Prisma can't express.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([buildId, slot, productId])
  @@index([productId])
}

// A guest cart (docs/specs/025-cart-single-items). The id is 128 random bits,
// held in the httpOnly __Host-cart cookie and nowhere else, so it is a bearer
// token and not a cuid. Stores products and quantities only: prices are
// always current and lock when an order is placed. userId waits for the
// Accounts epic (#65). The app never deletes a cart; abandoned ones are
// cleaned up later.
model Cart {
  id        String     @id
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// One line of a cart: a single item (buildId null) or a part of a build
// group (buildId set, added by #62). The migration also adds
// CHECK (quantity >= 1), which Prisma can't express.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  // Restrict: products are retired through status, never deleted
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  // Restrict: builds are immutable snapshots the app never deletes (ADR 0007)
  buildId   String?
  build     Build?   @relation(fields: [buildId], references: [id], onDelete: Restrict)
  // Cart lines are listed in the order they were added
  createdAt DateTime @default(now())

  // NULLs are distinct in a unique index, so the one-single-line rule needs
  // the partial index; the second covers the build groups
  @@unique([cartId, productId], where: { buildId: null })
  @@unique([cartId, productId, buildId])
  @@index([productId])
  @@index([buildId])
}

// The four shipping zones (docs/specs/028-shipping-data-and-fee-rules); the
// code uses "metro-manila" … "mindanao" (lib/shipping/zones.ts)
enum ShippingZone {
  METRO_MANILA
  LUZON
  VISAYAS
  MINDANAO
}

// One weight tier of a zone's shipping fee, in centavos. maxWeightGrams is the
// tier's upper limit; null is the zone's open-ended top tier. Seeded with
// demo values and edited in the admin panel later (AD-9). The migration also
// adds CHECK (maxWeightGrams > 0) and CHECK (fee >= 0), which Prisma can't
// express.
model ShippingRate {
  id             String       @id @default(cuid())
  zone           ShippingZone
  maxWeightGrams Int?
  fee            Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // NULLs are distinct in a unique index, so a zone's single open-ended tier
  // needs the partial index; the first covers the bounded tiers
  @@unique([zone, maxWeightGrams])
  @@unique([zone], where: { maxWeightGrams: null })
}

// The store's one settings row (id is always 1). The seed creates it only when
// it is missing, so it never overwrites what Admin sets. The migration also
// adds CHECK (id = 1), CHECK (freeShippingThreshold > 0) and
// CHECK (orderExpiryHours >= 1). COD limits come with FR-25.
model StoreSettings {
  id                    Int      @id @default(1)
  // Centavos; null turns free shipping off
  freeShippingThreshold Int?
  pickupEnabled         Boolean  @default(true)
  storeAddress          String
  storeHours            String
  storeInfo             String
  // Unpaid online orders auto-cancel after this many hours (FR-24)
  orderExpiryHours      Int      @default(24)
  updatedAt             DateTime @updatedAt
}

// The order's lifecycle (FR-20, docs/specs/030-place-an-order). Only
// PENDING_PAYMENT is reached by placing; PAID and CANCELLED come with #80 and
// #81, the rest with Admin. COD_CONFIRMED is Sprint 7 (FR-25).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COD_CONFIRMED
  PROCESSING
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

// Why stock moved. Only ORDER_RESERVED is written so far; the stories that
// release stock (#81) or adjust it (Admin) add their values.
enum StockMovementReason {
  ORDER_RESERVED
}

// A placed order (docs/specs/030-place-an-order, ADR 0009). Everything on it
// is a snapshot: later price, name or address edits never change it. Found by
// its short random number plus a secret access token; only the token's hash
// is stored, and the cart id is stored hashed too. Orders are never
// hard-deleted. The migration also adds CHECKs Prisma can't express: amounts
// are not negative, total = subtotal + shippingFee - discount, and a delivery
// order has an address and zone while a pickup order has neither.
model Order {
  id              String      @id @default(cuid())
  // "PCS-" and 8 Crockford base32 characters
  orderNumber     String      @unique
  // SHA-256 hex of a 256-bit random token that only the order link holds
  accessTokenHash String      @unique
  // The review's random key: a retry or double submit returns this order
  idempotencyKey  String      @unique
  // SHA-256 hex of the cart id it was placed from; the key only replays for
  // that cart
  cartIdHash      String
  status          OrderStatus @default(PENDING_PAYMENT)
  fulfillment     Fulfillment

  // Contact
  guestEmail    String
  contactName   String
  // +639XXXXXXXXX
  contactMobile String

  // Delivery address, as the dataset names it (all null for pickup).
  // provinceCode is null for independent cities and the pseudo-provinces,
  // which the PSA gives no province (docs/specs/029-checkout-steps, D14).
  regionCode           String?
  regionName           String?
  provinceCode         String?
  provinceName         String?
  provinceIsGeographic Boolean       @default(false)
  cityCode             String?
  cityName             String?
  barangayCode         String?
  barangayName         String?
  street               String?
  zip                  String?
  // The PSGC release the codes belong to
  psgcVersion          String?
  // Null for pickup
  zone                 ShippingZone?
  weightGrams          Int

  // Centavos
  subtotal    Int
  shippingFee Int
  discount    Int @default(0)
  total       Int

  // When an unpaid order auto-cancels (FR-24)
  expiresAt      DateTime
  items          OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([cartIdHash])
}

// One line of an order: a single item (buildId null) or a part of a build
// group (buildId and slot set). Names and prices are snapshots. The migration
// also adds CHECK (quantity >= 1) and CHECK ((buildId IS NULL) = (slot IS
// NULL)).
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Restrict: products are retired through status, never deleted
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  nameSnapshot  String
  // effectivePrice at placement, in centavos
  priceSnapshot Int
  quantity      Int
  // Restrict: builds are immutable snapshots the app never deletes (ADR 0007)
  buildId       String?
  build         Build?  @relation(fields: [buildId], references: [id], onDelete: Restrict)
  slot          String?
  // The line's place in the order: cart order, and slot order inside a group
  position      Int

  // Like CartItem: NULLs are distinct in a unique index, so the one-single-
  // line rule needs the partial index
  @@unique([orderId, productId], where: { buildId: null })
  @@unique([orderId, productId, buildId])
  @@index([productId])
  @@index([buildId])
}

// One change to a product's stock. change is negative for a reservation.
// actorId waits for the User table (Accounts, #65); until then it is plain
// text and always null.
model StockMovement {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  change    Int
  reason    StockMovementReason
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String?
  createdAt DateTime            @default(now())

  @@index([productId])
  @@index([orderId])
}
