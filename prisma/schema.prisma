generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  // Partial unique index on CartItem (docs/specs/025-cart-single-items, D1)
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  sku             String                   @unique
  description     String?
  price           Int // in centavos: ₱12,999.00 = 1299900
  salePrice       Int? // in centavos
  // What the shopper pays: COALESCE(salePrice, price). Set by a database
  // trigger on every insert and update (docs/specs/012-common-filters), so
  // the app never writes it and the default is only a placeholder. Filters
  // and price sorts use it.
  effectivePrice  Int                      @default(0)
  // The migration also adds CHECK (stock >= 0), which Prisma can't express: a
  // backstop behind the conditional update that places an order
  // (docs/specs/030-place-an-order)
  stock           Int                      @default(0)
  lowStockAt      Int                      @default(5)
  specs           Json // shape defined and validated by lib/specs (docs/adr/0002)
  weightGrams     Int
  warrantyMonths  Int                      @default(12)
  // What ships in the retail box, one line per item, in display order
  boxContents     String[]                 @default([])
  // Expected ship date while on pre-order; null when not a pre-order. A
  // passed date ends the pre-order (lib/stock.ts, docs/specs/010-product-page).
  preorderShipsOn DateTime?                @db.Date
  status          ProductStatus            @default(DRAFT)
  // Shown in the home page's "Featured products" (docs/specs/016-home-page),
  // in place of best sellers until there is order data
  isFeatured      Boolean                  @default(false)
  categoryId      String
  category        Category                 @relation(fields: [categoryId], references: [id])
  brandId         String
  brand           Brand                    @relation(fields: [brandId], references: [id])
  images          ProductImage[]
  // Keyword search: name, brand, SKU, string spec values and category name,
  // weighted. Set by database triggers (docs/specs/014-search, ADR 0005), so
  // the app never writes it. Optional only because a required Unsupported
  // field would remove create() from Prisma Client; it is never null.
  searchVector    Unsupported("tsvector")?
  buildItems      BuildItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([searchVector], type: Gin)
  // jsonb_path_ops: spec filters are equality/containment (@>); smaller and faster than jsonb_ops for that
  @@index([specs(ops: JsonbPathOps)], type: Gin)
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// A shared build: an immutable snapshot of a build's items, found by its
// content hash so the same contents always give the same row and link
// (docs/specs/022-share-build, ADR 0007). The app never updates or deletes
// one. Saved builds and cart snapshots will point at these rows.
model Build {
  id          String      @id @default(cuid())
  // The link: 10 random characters of a-z and 0-9, never derived from the
  // contents
  shareSlug   String      @unique
  // SHA-256 hex of the canonical items; only the server makes it
  contentHash String      @unique
  items       BuildItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model BuildItem {
  id        String  @id @default(cuid())
  buildId   String
  build     Build   @relation(fields: [buildId], references: [id], onDelete: Cascade)
  // A builder slot (the category slug), checked in code, not a database enum
  // (ADR 0002)
  slot      String
  // Restrict: products are retired through status, never deleted, so a
  // snapshot's parts always exist (docs/specs/022-share-build, "The data").
  // The migration also adds CHECK (quantity >= 1), which Prisma can't express.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([buildId, slot, productId])
  @@index([productId])
}

// A guest cart (docs/specs/025-cart-single-items). The id is 128 random bits,
// held in the httpOnly __Host-cart cookie and nowhere else, so it is a bearer
// token and not a cuid. Stores products and quantities only: prices are
// always current and lock when an order is placed. userId waits for the
// Accounts epic (#65). The app never deletes a cart; abandoned ones are
// cleaned up later.
model Cart {
  id        String     @id
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// One line of a cart: a single item (buildId null) or a part of a build
// group (buildId set, added by #62). The migration also adds
// CHECK (quantity >= 1), which Prisma can't express.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  // Restrict: products are retired through status, never deleted
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  // Restrict: builds are immutable snapshots the app never deletes (ADR 0007)
  buildId   String?
  build     Build?   @relation(fields: [buildId], references: [id], onDelete: Restrict)
  // Cart lines are listed in the order they were added
  createdAt DateTime @default(now())

  // NULLs are distinct in a unique index, so the one-single-line rule needs
  // the partial index; the second covers the build groups
  @@unique([cartId, productId], where: { buildId: null })
  @@unique([cartId, productId, buildId])
  @@index([productId])
  @@index([buildId])
}

// The four shipping zones (docs/specs/028-shipping-data-and-fee-rules); the
// code uses "metro-manila" … "mindanao" (lib/shipping/zones.ts)
enum ShippingZone {
  METRO_MANILA
  LUZON
  VISAYAS
  MINDANAO
}

// One weight tier of a zone's shipping fee, in centavos. maxWeightGrams is the
// tier's upper limit; null is the zone's open-ended top tier. Seeded with
// demo values and edited in the admin panel later (AD-9). The migration also
// adds CHECK (maxWeightGrams > 0) and CHECK (fee >= 0), which Prisma can't
// express.
model ShippingRate {
  id             String       @id @default(cuid())
  zone           ShippingZone
  maxWeightGrams Int?
  fee            Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // NULLs are distinct in a unique index, so a zone's single open-ended tier
  // needs the partial index; the first covers the bounded tiers
  @@unique([zone, maxWeightGrams])
  @@unique([zone], where: { maxWeightGrams: null })
}

// The store's one settings row (id is always 1). The seed creates it only when
// it is missing, so it never overwrites what Admin sets. The migration also
// adds CHECK (id = 1), CHECK (freeShippingThreshold > 0) and
// CHECK (orderExpiryHours >= 1). COD limits come with FR-25.
model StoreSettings {
  id                    Int      @id @default(1)
  // Centavos; null turns free shipping off
  freeShippingThreshold Int?
  pickupEnabled         Boolean  @default(true)
  storeAddress          String
  storeHours            String
  storeInfo             String
  // Unpaid online orders auto-cancel after this many hours (FR-24)
  orderExpiryHours      Int      @default(24)
  updatedAt             DateTime @updatedAt
}

enum VoucherType {
  // value is centavos off
  FIXED
  // value is a whole percent, 1 to 100
  PERCENT
}

// A voucher code (FR-17, docs/specs/037-vouchers-at-checkout). Rows come from
// the seed until Admin (Sprint 9). usedCount counts the orders holding the code
// that are not cancelled: taken when an order is placed, given back when the
// release cancels it. The migration adds CHECKs Prisma can't express: code is
// 3 to 32 of A-Z 0-9 _ -, percent 1 to 100, fixed above 0, minSpend not
// negative, usageLimit null or at least 1, 0 <= usedCount <= usageLimit, and
// endsAt after startsAt. Never deleted once an order points at it (Restrict).
model Voucher {
  id         String      @id @default(cuid())
  // Upper-case; looked up from the shopper's text trimmed and upper-cased
  code       String      @unique
  type       VoucherType
  value      Int
  // Centavos on the subtotal before the discount; 0 for none
  minSpend   Int         @default(0)
  startsAt   DateTime
  // null: never ends
  endsAt     DateTime?
  // null: unlimited
  usageLimit Int?
  usedCount  Int         @default(0)
  orders     Order[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// The order's lifecycle (FR-20, docs/specs/030-place-an-order). Only
// PENDING_PAYMENT is reached by placing; PAID and CANCELLED come with #80 and
// #81, the rest with Admin. COD_CONFIRMED is Sprint 7 (FR-25).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COD_CONFIRMED
  PROCESSING
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

// Why stock moved. Only ORDER_RESERVED is written so far; the stories that
// release stock (#81) or adjust it (Admin) add their values.
enum StockMovementReason {
  ORDER_RESERVED
  // An unpaid order's stock given back (docs/specs/033-release-unpaid-orders)
  ORDER_RELEASED
}

// Why an order was cancelled. Admin adds its own reasons in Sprint 8.
enum OrderCancelReason {
  // Not paid by expiresAt (FR-24, docs/specs/033-release-unpaid-orders)
  EXPIRED
}

// A placed order (docs/specs/030-place-an-order, ADR 0009). Everything on it
// is a snapshot: later price, name or address edits never change it. Found by
// its short random number plus a secret access token; only the token's hash
// is stored, and the cart id is stored hashed too. Orders are never
// hard-deleted. The migration also adds CHECKs Prisma can't express: amounts
// are not negative, total = subtotal + shippingFee - discount, discount does
// not pass the subtotal and needs a voucher, and a delivery order has an
// address and zone while a pickup order has neither.
model Order {
  id              String      @id @default(cuid())
  // "PCS-" and 8 Crockford base32 characters
  orderNumber     String      @unique
  // SHA-256 hex of a 256-bit random token that only the order link holds
  accessTokenHash String      @unique
  // The review's random key: a retry or double submit returns this order
  idempotencyKey  String      @unique
  // SHA-256 hex of the cart id it was placed from; the key only replays for
  // that cart
  cartIdHash      String
  status          OrderStatus @default(PENDING_PAYMENT)
  fulfillment     Fulfillment

  // Contact
  guestEmail    String
  contactName   String
  // +639XXXXXXXXX
  contactMobile String

  // Delivery address, as the dataset names it (all null for pickup).
  // provinceCode is null for independent cities and the pseudo-provinces,
  // which the PSA gives no province (docs/specs/029-checkout-steps, D14).
  regionCode           String?
  regionName           String?
  provinceCode         String?
  provinceName         String?
  provinceIsGeographic Boolean       @default(false)
  cityCode             String?
  cityName             String?
  barangayCode         String?
  barangayName         String?
  street               String?
  zip                  String?
  // The PSGC release the codes belong to
  psgcVersion          String?
  // Null for pickup
  zone                 ShippingZone?
  weightGrams          Int

  // Centavos
  subtotal    Int
  shippingFee Int
  discount    Int @default(0)
  total       Int

  // The voucher the discount came from (docs/specs/037-vouchers-at-checkout):
  // the row, kept (Restrict) so its use can be given back, and the code as it
  // was, a snapshot. Both set or both null.
  voucherId   String?
  voucher     Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  voucherCode String?

  // When an unpaid order auto-cancels (FR-24)
  expiresAt      DateTime
  // Set with PAID by reconcileSession (docs/specs/032-payment-webhooks). The
  // migration adds CHECK: a pending order was never paid.
  paidAt         DateTime?
  // The gateway's channel code: GCASH, PAYMAYA, CARDS (FAKE in tests)
  paymentMethod  String?
  // A payment arrived after cancellation, or a second one after Paid (FR-26).
  // Only ever set to true here; clearing it is Admin's refund (Sprint 8).
  refundRequired Boolean            @default(false)
  // Set with CANCELLED (docs/specs/033-release-unpaid-orders); the migration
  // adds CHECKs: a cancelled order has both, a pending one has neither
  cancelledAt    DateTime?
  cancelReason   OrderCancelReason?
  items          OrderItem[]
  stockMovements StockMovement[]
  payments       Payment[]
  emails         EmailOutbox[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([cartIdHash])
  @@index([voucherId])
  // The release's one query: unpaid orders by when they expire
  @@index([expiresAt], where: { status: "PENDING_PAYMENT" })
}

// One line of an order: a single item (buildId null) or a part of a build
// group (buildId and slot set). Names and prices are snapshots. The migration
// also adds CHECK (quantity >= 1) and CHECK ((buildId IS NULL) = (slot IS
// NULL)).
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Restrict: products are retired through status, never deleted
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  nameSnapshot  String
  // effectivePrice at placement, in centavos
  priceSnapshot Int
  quantity      Int
  // Restrict: builds are immutable snapshots the app never deletes (ADR 0007)
  buildId       String?
  build         Build?  @relation(fields: [buildId], references: [id], onDelete: Restrict)
  slot          String?
  // The line's place in the order: cart order, and slot order inside a group
  position      Int

  // Like CartItem: NULLs are distinct in a unique index, so the one-single-
  // line rule needs the partial index
  @@unique([orderId, productId], where: { buildId: null })
  @@unique([orderId, productId, buildId])
  @@index([productId])
  @@index([buildId])
}

// One change to a product's stock. change is negative for a reservation.
// actorId waits for the User table (Accounts, #65); until then it is plain
// text and always null.
model StockMovement {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  change    Int
  reason    StockMovementReason
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String?
  createdAt DateTime            @default(now())

  @@index([productId])
  @@index([orderId])
}

// The gateway a payment went through (docs/specs/031-pay-with-xendit, ADR
// 0010). FAKE is the test gateway of CI, E2E and previews.
enum PaymentProvider {
  XENDIT
  FAKE
}

// OPENING while startPayment asks the gateway for a session; PENDING while its
// session is open; EXPIRED when the session closed unpaid (a retry, #81's
// release, or the gateway's expiry); PAID when the gateway confirms it
// (docs/specs/032-payment-webhooks). FAILED is an attempt that got no session
// of ours: its create or close failed, or it was abandoned (docs/specs/034-
// start-payment-outside-transaction). Xendit never ends a session as failed.
enum PaymentStatus {
  OPENING
  PENDING
  PAID
  FAILED
  EXPIRED
}

// One payment attempt: one gateway session (FR-23). Never hard-deleted.
model Payment {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  // The gateway's session id (Xendit: ps-…); null while OPENING and on a
  // FAILED attempt, which never got one (the migration adds CHECK: null
  // exactly then; docs/specs/034-start-payment-outside-transaction)
  providerRef      String?
  // "{orderNumber}-{attempt}", as sent to the gateway
  referenceId      String
  // Centavos
  amount           Int
  currency         String          @default("PHP")
  status           PaymentStatus   @default(PENDING)
  // When the session expires at the gateway
  expiresAt        DateTime
  // The method paid with (GCASH, PAYMAYA, CARDS), set when Paid
  method           String?
  // Set with PAID (docs/specs/032-payment-webhooks); the migration adds
  // CHECK: status PAID exactly when paidAt is set
  paidAt           DateTime?
  // The gateway's payment id (Xendit: py-…)
  gatewayPaymentId String?
  // What the gateway received, in centavos, even when it doesn't match
  receivedAmount   Int?
  receivedCurrency String?
  // Why the payment needs Admin: a mismatch, a late or a second payment
  problem          PaymentProblem?
  events           PaymentEvent[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([provider, providerRef])
  // At most one open session per order (spec 031, §4)
  @@unique([orderId], where: { status: "PENDING" })
  // At most one start in flight per order (docs/specs/034-start-payment-
  // outside-transaction). Not one index with PENDING: during a retry the old
  // session stays PENDING until it is closed, beside the new OPENING attempt.
  @@unique([orderId], where: { status: "OPENING" }, map: "Payment_orderId_opening_key")
  @@index([orderId])
}

// Why a paid payment needs Admin (docs/specs/032-payment-webhooks, D7)
enum PaymentProblem {
  // The amount or currency isn't the order's: the order stays unpaid
  AMOUNT_MISMATCH
  // Paid after the order was cancelled: refund
  LATE
  // Paid after another payment already paid the order: refund
  SECOND_PAYMENT
}

// One gateway webhook event that was processed, so the same event changes
// nothing twice (FR-23; docs/specs/032-payment-webhooks). Xendit sends no
// event id, so eventId is "{event}:{payment_session_id}". Written in the same
// transaction as the change it causes; ignored events (unknown, another
// environment) are never stored. Never deleted.
model PaymentEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  // The body as received
  payload    Json
  // Null for an orphan session that expired unpaid
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receivedAt DateTime @default(now())

  @@index([paymentId])
}

// The fake gateway's own sessions (docs/specs/031-pay-with-xendit, D8), in
// Xendit's shapes and statuses, so the fake can answer "completed" without
// reading the store's Payment rows. No foreign keys: a gateway knows nothing
// of our tables. Unused where PAYMENT_GATEWAY is xendit.
model FakeGatewaySession {
  // "ps-" and 24 hex characters, like Xendit's payment_session_id
  id          String   @id
  // ACTIVE, COMPLETED, EXPIRED or CANCELED (Xendit's words)
  status      String
  // Centavos
  amount      Int
  currency    String
  referenceId String
  metadata    Json
  expiresAt   DateTime
  // "py-…", once paid
  paymentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EmailType {
  ORDER_PLACED
  PAYMENT_RECEIVED
  ORDER_CANCELLED
  COD_CONFIRM
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// One email to send for an order (docs/specs/035-email-foundation-signed-
// links): written in the transaction that causes it and sent after the
// commit. It stores no address, no rendered email and no secret: the email is
// built from the order row at send time, and only the recipient's hash is
// kept, for the per-recipient cap. Never hard-deleted. The migration adds
// CHECKs Prisma can't express: attempts are not negative, a sent row has its
// time and message id (and only a sent row does), a sending row has its claim
// time, and the hash is 64 hex characters (lib/email/schema.db.test.ts).
model EmailOutbox {
  id                String      @id @default(cuid())
  orderId           String
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type              EmailType
  status            EmailStatus @default(PENDING)
  // SHA-256 hex of the normalized address (lib/email/recipient.ts)
  recipientHash     String
  // Claims, takeovers included
  attempts          Int         @default(0)
  // A short code: timeout, network, http-422:validation_error, no-template,
  // too-old. Never a message or a body.
  lastErrorCode     String?
  // The last claim; a sending row older than the lease is taken over
  claimedAt         DateTime?
  sentAt            DateTime?
  providerMessageId String?
  createdAt         DateTime    @default(now())

  // One email of each type per order: writing twice is a no-op
  @@unique([orderId, type])
  // The cap counts a recipient's recent rows
  @@index([recipientHash, sentAt])
  // The due scan
  @@index([status, claimedAt])
}

// What the fake email transport "sent", for the tests and E2E to read
// (docs/specs/035-email-foundation-signed-links, D11). Holds addresses and
// bodies, so it exists only where EMAIL_TRANSPORT is fake. Like Resend, the
// same idempotency key returns the same message.
model FakeEmail {
  // "fake_" and hex, also the providerMessageId
  id             String   @id
  idempotencyKey String   @unique
  from           String
  to             String
  subject        String
  html           String
  text           String
  createdAt      DateTime @default(now())
}
