NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Integration tests only (pnpm test:db): the local Docker Postgres from
# docker-compose.yml (pnpm test:db:up). The tests empty its catalog tables and
# refuse to run on the same host as DATABASE_URL. Local-only credentials.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pcsilicon_test"

# Production database host (no scheme or user, e.g. ep-xxxx.region.aws.neon.tech): `pnpm db:seed --reset` and the E2E stock helper (e2e/stock.ts) refuse to run against it, or without it. Local .env.local only; not needed on Vercel or in CI.
PRODUCTION_DATABASE_HOST=""

# Placing orders (docs/specs/030-place-an-order): "true" or "false", unset means off. On locally and in Vercel Preview; leave it unset in Production until unpaid orders release their stock (#81).
ORDERS_ENABLED="true"
