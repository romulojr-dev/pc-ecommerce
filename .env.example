NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Integration tests only (pnpm test:db): the local Docker Postgres from
# docker-compose.yml (pnpm test:db:up). The tests empty its catalog tables and
# refuse to run on the same host as DATABASE_URL. Local-only credentials.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pcsilicon_test"

# Production database host (no scheme or user, e.g. ep-xxxx.region.aws.neon.tech): `pnpm db:seed --reset` and the E2E stock helper (e2e/stock.ts) refuse to run against it, or without it. Local .env.local only; not needed on Vercel or in CI.
PRODUCTION_DATABASE_HOST=""

# Placing orders (docs/specs/030-place-an-order): "true" or "false", unset means off. On locally and in Vercel Preview; leave it unset in Production until releasing unpaid orders' stock (#81, docs/specs/033-release-unpaid-orders) is deployed.
ORDERS_ENABLED="true"

# Payments (docs/specs/031-pay-with-xendit, docs/setup/payments.md). The gateway is "xendit" or "fake" and is required; Production refuses "fake". Locally use "fake"; for real Xendit set "xendit", the test key and a tunnel's https origin as NEXT_PUBLIC_SITE_URL.
PAYMENT_GATEWAY="fake"
# Xendit test-mode secret key (xnd_development_…); a live key stops startup. Only needed with PAYMENT_GATEWAY="xendit". Never commit or paste it.
XENDIT_SECRET_KEY=""
# Xendit's webhook verification token (Dashboard → Webhooks), required with both gateways: POST /api/webhooks/xendit checks it. With "fake", any random value: the test payment page sends it with its events.
XENDIT_WEBHOOK_TOKEN="any-random-value"
# What Vercel's daily cron sends to GET /api/cron/release-orders (docs/specs/033-release-unpaid-orders), at least 16 characters. Only Production's cron needs it; unset, the route refuses every call. To run the cron by hand locally, set any value and send it as `Authorization: Bearer …`.
CRON_SECRET=""

# Email (docs/specs/035-email-foundation-signed-links, docs/setup/domain.md). The transport is "resend" or "fake" and is required; Production refuses "fake". Locally use "fake": emails are recorded in the FakeEmail table and never sent.
EMAIL_TRANSPORT="fake"
# Resend sending key, only with EMAIL_TRANSPORT="resend". Never commit or paste it.
RESEND_API_KEY=""
# Optional; the default is shown.
EMAIL_FROM="PC Silicon <orders@mail.pcsilicon.tech>"
# Signs the order links in emails (HMAC-SHA256), at least 32 bytes, one per environment. Locally any long random text; rotating it revokes every link already sent (e.g. `openssl rand -base64 48`).
ORDER_LINK_SECRET="local-dev-order-link-secret-change-me-0123456789"

# Staff sign-in (docs/specs/039-staff-sign-in-admin-shell, ADR 0012, docs/setup/admin-accounts.md). Signs the admin session cookie: at least 32 bytes, different from ORDER_LINK_SECRET, and a different value in Production, Preview and Development. Rotating it signs everyone out (e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET="local-dev-better-auth-secret-change-me-0123456789"
# The public demo account's password (at least 12 characters). Shown on /admin/login and used by `pnpm db:seed --accounts-only`. Leave unset for no demo box and no demo user.
DEMO_ACCOUNT_PASSWORD=""
# Read by Playwright only (the E2E owner and staff accounts, created with `pnpm staff:create`): at least 12 characters, never committed.
E2E_ACCOUNT_PASSWORD=""

# Product photos (docs/specs/049-product-images-upload, ADR 0013). The storage is "blob" or "fake" and is required; Production refuses "fake". Locally use "fake": uploads are kept in the FakeStoredImage table and served from /test-images.
IMAGE_STORAGE="fake"
# Only with IMAGE_STORAGE="blob"; one store per environment. Vercel adds BLOB_STORE_ID (and VERCEL_OIDC_TOKEN, which @vercel/blob reads itself) when the store is connected to the project; the SDK authenticates with OIDC. BLOB_READ_WRITE_TOKEN is the fallback for a connection without OIDC or code running off Vercel (tick "Add a read-write token env var" on the connection); set one or both, and both must name the same store. Never commit or paste the token.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
# Preview only: production's Blob host (e.g. abc123.public.blob.vercel-storage.com), when the preview databases are branched from production (look at a preview branch's parent in the Neon console). Leave unset otherwise.
BLOB_PRODUCTION_HOST=""
